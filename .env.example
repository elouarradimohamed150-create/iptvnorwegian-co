# Public URL of the live site (used for Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=https://iptvnorwegian.co

# Stripe – enables real checkout. Without it, "Order" buttons open email/WhatsApp.
STRIPE_SECRET_KEY=sk_live_...

# Resend – enables the contact form. Without it, the form opens the visitor's email app.
RESEND_API_KEY=re_...
CONTACT_TO=goldengateiptv@gmail.com
CONTACT_FROM=IPTV Norwegian <noreply@iptvnorwegian.co>

# Analytics (pick one or both)
# Plausible is cookie-free, so no consent banner is needed.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=iptvnorwegian.co
# Google Analytics sets cookies, so the consent banner appears automatically.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console: paste the "content" value of the HTML-tag verification method
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set to "stripe" to send paid "Order now" buttons to Stripe checkout instead of WhatsApp.
NEXT_PUBLIC_CHECKOUT=
